# 禁止提交 MySQL 表空间/表定义/套接字
*.ibd
*.frm
*.sock
*.pid
*.log

# 禁止提交 SQL dump / 业务数据备份
*.sql.gz
*.sql.bz2
*.sql.zip
# 纯 .sql 文件里 schema 可以提交；但真实业务数据 dump（如 backup_*.sql、dump_*.sql）需拒绝
dump_*.sql
backup_*.sql

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.DS_Store
