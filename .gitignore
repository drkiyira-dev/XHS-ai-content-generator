# ---------- 环境变量 & 密钥（必须保留：C 侧成员约定）----------
.env
.env.*
!.env.example

# ---------- 本地虚拟环境 ----------
.venv/
venv/
env/

# ---------- Python 字节码 & 缓存 ----------
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------- 上传目录（保留 .gitkeep）----------
uploads/*
!uploads/.gitkeep

# ---------- SQLite 临时数据库文件 ----------
*.db
*.sqlite
*.sqlite3

# ---------- MySQL server data & sockets ----------
mysql/data/
data/mysql/
**/mysql/data/**
*.ibd
*.frm
*.sock
*.pid

# ---------- SQL dump / 业务数据备份（schema 可以提交，但 backup/dump 不行）----------
*.sql.gz
*.sql.bz2
*.sql.zip
dump_*.sql
backup_*.sql

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- 前端（必须保留：前端 node_modules / dist）----------
frontend/node_modules/
frontend/dist/

# ---------- 系统 / IDE ----------
.DS_Store
.idea/
.vscode/
*.swp
*.swo
