# ---------- 环境变量 & 密钥（C 侧强约束：必须保留在首 3 行）----------
.env
.env.*
!.env.example

# ---------- 本地虚拟环境 ----------
.venv/
venv/
env/

# ---------- Python 字节码 & 缓存 ----------
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------- 上传目录（保留 .gitkeep）----------
uploads/*
!uploads/.gitkeep

# ---------- SQLite 临时数据库文件 ----------
*.db
*.sqlite
*.sqlite3

# ---------- MySQL server data & sockets ----------
mysql/data/
data/mysql/
**/mysql/data/**
*.ibd
*.frm
*.sock
*.pid

# ---------- SQL dump / 业务数据备份（schema 可提交；dump/backup 禁止）----------
*.sql.gz
*.sql.bz2
*.sql.zip
dump_*.sql
backup_*.sql

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- 前端（develop 版 + C 版合并：node_modules/dist + frontend/.env）----------
frontend/node_modules/
frontend/dist/
frontend/.env

# ---------- 后端（来自 develop：backend/__pycache__ / backend/.env / backend/uploads/）----------
backend/__pycache__/
backend/.env
backend/uploads/

# ---------- 系统 / IDE ----------
.DS_Store
.idea/
.vscode/
*.swp
*.swo
