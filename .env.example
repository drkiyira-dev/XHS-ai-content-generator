# Copy this file to .env and fill in real values locally.
# Never commit the real .env file.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
VISION_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
OCR_MODEL_NAME=PaddlePaddle/PaddleOCR-VL-1.5
MODEL_TIMEOUT_SECONDS=60
OCR_TIMEOUT_SECONDS=15
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_PIXELS=50000000
MODEL_MAX_IMAGE_EDGE=3584

# MySQL persistence is opt-in. Keep disabled until a dedicated database,
# non-root user, and generation_records table have been provisioned.
DATABASE_ENABLED=false
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_READ_TIMEOUT_SECONDS=30
DATABASE_WRITE_TIMEOUT_SECONDS=30
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=1800
# Required only for a non-loopback MySQL host.
DATABASE_TLS_CA=
